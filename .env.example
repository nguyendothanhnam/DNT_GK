# local: chay thu JSON. firestore: Cloud Firestore. firebase: Realtime Database.
DB_MODE=local
PORT=3001
HOST=0.0.0.0
ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456
# Chi backend doc hai bien nay. Khong them tien to EXPO_PUBLIC_.
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_SECRET=
# Uu tien service account neu da co file khoa backend.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
FIREBASE_PROJECT_ID=dntgk-c5558
# Web tren may tinh: localhost. Dien thoai: IP LAN cua may chay API.
EXPO_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
